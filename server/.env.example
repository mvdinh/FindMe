# Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI_PROD=mongodb+srv://shopprovie_db_user:BitoRcEXmE2D5uON@cluster0.kxvqooa.mongodb.net/?appName=Cluster0


# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_make_it_complex
JWT_EXPIRES_IN=7d

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Common options: gemini-1.5-flash-latest, gemini-1.5-pro-latest, gemini-1.5-flash-8b

# ATS: optional Python service (scan_chamdiemCV / FastAPI). Used when job.atsEngine === scan_cv
# ATS_SCAN_API_URL=http://127.0.0.1:8000
# ATS_SCAN_TIMEOUT_MS=120000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
APP_NAME=FINDME

# Cloudinary (Upload CV/Resume)
# - KHÔNG commit key thật lên git. Chỉ cấu hình trong `server/.env` khi chạy local/deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Bật log upload Cloudinary (optional)
# CLOUDINARY_LOG=true

# CORS
CORS_ORIGIN=http://localhost:5173
# PUBLIC_APP_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MUTATION_MAX=100
# RATE_LIMIT_MAX_REQUESTS applies to general (mostly GET) traffic.
# RATE_LIMIT_AUTH_MAX applies to /api/auth endpoints (login/register/reset etc.).
# RATE_LIMIT_MUTATION_MAX applies to write-heavy role routes (/api/applications,/api/hr,/api/admin,/api/interviewer,/api/applicant).