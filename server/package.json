{
  "name": "findme-backend",
  "version": "1.0.0",
  "description": "findme Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node --max-http-header-size=32768 server.js",
    "dev": "nodemon --max-http-header-size=32768 server.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:users": "node scripts/seed-users.js",
    "seed:demo": "node scripts/seedDemoData.js",
    "reset:db": "node scripts/reset-db.js",
    "migrate:education-vn": "node scripts/migrate-education-vn.js",
    "migrate:jobs-vn": "node scripts/migrate-jobs-vn.js",
    "test": "jest",
    "test:parser": "node test-document-parser.js",
    "test:setup": "node test-setup.js",
    "test:backend": "node test-backend-implementation.js",
    "test:api": "node test-api-endpoints.js",
    "strip-comments": "node scripts/removeComments.cjs"
  },
  "keywords": [
    "findme",
    "recruitment",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.29.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "axios": "^1.12.2",
    "form-data": "^4.0.4",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": false,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}
